# MacroPulse AI — example environment. Copy to `.env` (never commit `.env`).
# All values here are illustrative placeholders; no real secrets.

# --- API (FastAPI) ---
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Local default (no Docker): SQLite file under data/local/. Production/compose: PostgreSQL.
# DATABASE_URL=sqlite:///data/local/macropulse.db
# DATABASE_URL=postgresql+psycopg://macropulse:macropulse@localhost:5432/macropulse
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional, server-side only. Enables FRED API / ALFRED vintages (https://fred.stlouisfed.org/docs/api/api_key.html).
# Leave empty to run without it; FRED features that need it are then reported as unavailable.
FRED_API_KEY=

# Trained model artifacts (written by `macropulse train`, read by the API). The API loads
# artifacts only from inside this directory. Default: models/artifacts in the repository.
# MODELS_DIR=models/artifacts

# --- Web (Next.js) ---
# Server-side URL the Next.js server uses to proxy /api/* to FastAPI. Not exposed to the browser.
API_URL=http://127.0.0.1:8000

# --- docker compose (PostgreSQL) ---
POSTGRES_USER=macropulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=macropulse
