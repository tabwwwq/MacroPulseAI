{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "macropulse",
        "serve",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@macropulse/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@macropulse/web",
        "start",
        "--hostname",
        "127.0.0.1"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}
