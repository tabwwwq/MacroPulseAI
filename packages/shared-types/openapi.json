{
  "components": {
    "schemas": {
      "Country": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "euro_area_member": {
            "title": "Euro Area Member",
            "type": "boolean"
          },
          "iso2": {
            "title": "Iso2",
            "type": "string"
          },
          "iso3": {
            "title": "Iso3",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "policy_rate_scope": {
            "$ref": "#/components/schemas/PolicyRateScope",
            "description": "`euro_area_shared`: the ECB rate applies to all euro area members; it is not a national central-bank rate."
          },
          "primary_gdp_source": {
            "title": "Primary Gdp Source",
            "type": "string"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "support": {
            "$ref": "#/components/schemas/CountrySupport"
          }
        },
        "required": [
          "iso2",
          "iso3",
          "name",
          "region",
          "currency",
          "euro_area_member",
          "policy_rate_scope",
          "primary_gdp_source",
          "support"
        ],
        "title": "Country",
        "type": "object"
      },
      "CountryList": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Country"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "count"
        ],
        "title": "CountryList",
        "type": "object"
      },
      "CountrySupport": {
        "properties": {
          "level": {
            "$ref": "#/components/schemas/SupportLevel",
            "description": "Current level, computed from ingested observations."
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/SupportLevel",
            "description": "Level the project aims to support for this country."
          }
        },
        "required": [
          "level",
          "target",
          "reason"
        ],
        "title": "CountrySupport",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error code, e.g. `unsupported_country`.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "description": "Human-readable, safe-to-display explanation.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Echo of the X-Request-ID header.",
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "time_utc": {
            "format": "date-time",
            "title": "Time Utc",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment",
          "time_utc"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PolicyRateScope": {
        "description": "Whether a country's policy rate is set nationally or shared across a currency union.",
        "enum": [
          "euro_area_shared",
          "national"
        ],
        "title": "PolicyRateScope",
        "type": "string"
      },
      "ReadinessCheck": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "detail"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SourceStatus": {
        "properties": {
          "api_key_configured": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the server has the key configured (the key itself is never exposed). `null` when the source needs no key.",
            "title": "Api Key Configured"
          },
          "attribution": {
            "title": "Attribution",
            "type": "string"
          },
          "docs_url": {
            "title": "Docs Url",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_attempt_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start of the most recent sync attempt.",
            "title": "Last Attempt At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_rows_upserted": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Rows Upserted"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Data freshness = finish time of the last successful fetch. This is not the observation reference period and not the source's publication date.",
            "title": "Last Success At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "requires_api_key": {
            "title": "Requires Api Key",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "never_synced",
              "running",
              "ok",
              "degraded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "terms_url": {
            "title": "Terms Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "docs_url",
          "terms_url",
          "attribution",
          "requires_api_key",
          "api_key_configured",
          "status",
          "last_attempt_at",
          "last_success_at",
          "last_rows_upserted",
          "last_error"
        ],
        "title": "SourceStatus",
        "type": "object"
      },
      "SourceStatusList": {
        "properties": {
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "generated_at"
        ],
        "title": "SourceStatusList",
        "type": "object"
      },
      "SupportLevel": {
        "enum": [
          "full",
          "partial",
          "unavailable"
        ],
        "title": "SupportLevel",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "\nMacroeconomic intelligence and technical-recession early-warning API.\n\n* **Historical statistics** come only from official sources (Eurostat, ECB, FRED, World Bank, OECD)\n  with provenance; missing data is reported as missing, never imputed silently.\n* **Model outputs** are analytical estimates, not investment advice. A *technical recession* (two\n  consecutive negative q/q real-GDP quarters) is distinct from an official NBER recession.\n",
    "title": "MacroPulse AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/countries": {
      "get": {
        "operationId": "list_countries_api_countries_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List supported countries",
        "tags": [
          "countries"
        ]
      }
    },
    "/api/countries/{iso2}": {
      "get": {
        "operationId": "get_one_api_countries__iso2__get",
        "parameters": [
          {
            "description": "ISO 3166-1 alpha-2 code (case-insensitive).",
            "in": "path",
            "name": "iso2",
            "required": true,
            "schema": {
              "description": "ISO 3166-1 alpha-2 code (case-insensitive).",
              "examples": [
                "DE"
              ],
              "pattern": "^[A-Za-z]{2}$",
              "title": "Iso2",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Country"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed or unsupported code."
          }
        },
        "summary": "Get one country",
        "tags": [
          "countries"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Process is up. Does not touch the database or external sources.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/ready": {
      "get": {
        "description": "Database reachable, schema at the latest migration and registry seeded.",
        "operationId": "ready_api_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "One or more checks failed."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/sources/status": {
      "get": {
        "operationId": "sources_status_api_sources_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceStatusList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Source health and freshness",
        "tags": [
          "sources"
        ]
      }
    }
  }
}
